BT 1 0 0 1 7 68.8 Tm /F4 8.2 Tf 11 TL (student <- list\(name="Asha", marks=c\(78, 85, 92\), passed=TRUE\)) Tj T* (avg <- mean\(student$marks\)) Tj T* (print\(avg\)) Tj T* (student$grade <- if \(avg >= 85\) "A" else "B") Tj T* (print\(student$grade\)) Tj T* (length\(student\)) Tj T* (names\(student\)) Tj T* ET
